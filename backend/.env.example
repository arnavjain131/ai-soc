# Local SQLite is development-only. Production requires PostgreSQL with TLS.
APP_ENV=development
DATABASE_URL=sqlite:///./soc.db
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
ALLOWED_ORIGINS=http://localhost:5173
# Optional per-process API admission limits (defaults shown; do not disable).
SOC_REQUESTS_PER_CREDENTIAL_MINUTE=120
SOC_REQUEST_POOL_PER_MINUTE=600
SOC_REQUEST_BURST=30
SOC_REQUEST_MAX_IN_FLIGHT=16
# AI is opt-in. Keep disabled until provider billing/data handling are reviewed.
SOC_AI_ENABLED=false
OPENAI_API_KEY=
SOC_AI_MODEL=gpt-5.4-mini-2026-03-17
SOC_AI_DAILY_LIMIT=3
SOC_AI_MONTHLY_LIMIT=30
SOC_AI_MAX_OUTPUT_TOKENS=2000
